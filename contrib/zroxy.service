# Sample systemd unit for zroxy. Not installed by default: copy it to
# /etc/systemd/system/zroxy.service and adjust the paths.
#
# systemd hands the service only CAP_NET_BIND_SERVICE, so zroxy never needs
# root, even for ports below 1024. DynamicUser= creates an unprivileged
# user for the run; it can not read files that only root may read. Make the
# config file, whitelist and any secret files readable by that user, for
# example with SupplementaryGroups= or LoadCredential=, or use a fixed
# User=zroxy instead.
#
# The monitor reads /proc/self; ProtectProc= and ProcSubset= are left at
# their defaults on purpose.

[Unit]
Description=zroxy SNI and DNS proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/local/bin/zroxy -c /etc/zroxy/zroxy.conf
# Reloads the whitelist.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
