if(NOT DEFINED READELF OR NOT DEFINED ZROXY_BIN)
    message(FATAL_ERROR "READELF and ZROXY_BIN are required")
endif()

execute_process(COMMAND "${READELF}" -l "${ZROXY_BIN}" RESULT_VARIABLE RESULT OUTPUT_VARIABLE PROGRAM_HEADERS ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "readelf -l failed: ${ERROR}")
endif()
execute_process(COMMAND "${READELF}" -d "${ZROXY_BIN}" RESULT_VARIABLE DYNAMIC_RESULT OUTPUT_VARIABLE DYNAMIC_OUTPUT ERROR_QUIET)
execute_process(COMMAND "${READELF}" -Ws "${ZROXY_BIN}" RESULT_VARIABLE SYMBOL_RESULT OUTPUT_VARIABLE SYMBOL_OUTPUT ERROR_QUIET)

if(ZROXY_HARDENING_RELRO)
    string(FIND "${PROGRAM_HEADERS}" "GNU_RELRO" RELRO_POSITION)
    if(RELRO_POSITION EQUAL -1)
        message(FATAL_ERROR "hardening check: GNU_RELRO program header is missing")
    endif()
endif()

if(ZROXY_HARDENING_NOW)
    if(NOT DYNAMIC_RESULT EQUAL 0 OR DYNAMIC_OUTPUT MATCHES "There is no dynamic section")
        message(STATUS "hardening check: skipping NOW check (no dynamic section)")
    else()
        string(REGEX MATCH "(BIND_NOW|FLAGS_1[^\\n]*NOW)" NOW_MATCH "${DYNAMIC_OUTPUT}")
        if(NOT NOW_MATCH)
            message(FATAL_ERROR "hardening check: BIND_NOW/FLAGS_1 NOW is missing")
        endif()
    endif()
endif()

set(HAS_SYMBOLS FALSE)
if(SYMBOL_RESULT EQUAL 0 AND SYMBOL_OUTPUT MATCHES "Symbol table" AND SYMBOL_OUTPUT MATCHES "__")
    set(HAS_SYMBOLS TRUE)
endif()
if(NOT HAS_SYMBOLS AND (ZROXY_HARDENING_STACK OR ZROXY_HARDENING_FORTIFY))
    message(STATUS "hardening check: skipping stack and fortify checks (no usable symbol table)")
endif()

if(ZROXY_HARDENING_STACK AND HAS_SYMBOLS)
    string(FIND "${SYMBOL_OUTPUT}" "__stack_chk_fail" STACK_POSITION)
    if(STACK_POSITION EQUAL -1)
        message(FATAL_ERROR "hardening check: __stack_chk_fail reference is missing")
    endif()
endif()

if(ZROXY_HARDENING_FORTIFY AND HAS_SYMBOLS)
    string(REGEX MATCH "__[^ \t\\n]*_chk(@[^ \t\\n]*)?([ \t\\n]|$)" FORTIFY_MATCH "${SYMBOL_OUTPUT}")
    if(NOT FORTIFY_MATCH)
        message(FATAL_ERROR "hardening check: no fortified __*_chk symbol reference was found")
    endif()
endif()
