#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled config_file

	config_load zroxy
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get config_file main config_file /etc/zroxy/zroxy.conf
	[ -f "$config_file" ] || {
		logger -t zroxy "configuration file not found: $config_file"
		return 1
	}

	procd_open_instance
	procd_set_param command /usr/bin/zroxy -c "$config_file"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

# zroxy handles SIGHUP by reloading only the hostname whitelist.
# Restart the service after changing the main configuration file or UCI options.
reload_service() {
	procd_send_signal zroxy '*' HUP
}
