# zroxy settings. The init script turns them into the native configuration
# file /var/etc/zroxy/zroxy.conf each time the service starts or reloads.
#
# If "option config_file" is set below, that hand-written file is used
# instead and everything except enabled, jail and config_file is ignored.
# Remove it with: uci delete zroxy.main.config_file

config zroxy 'main'
	option enabled '0'
	# Run zroxy in a procd jail (ujail) with a read-only view of its files.
	option jail '1'
	# SNI listeners, one per entry: [BIND-IP:]PORT[@REMOTE-PORT][,...].
	# Change this to the router's LAN address to serve LAN clients.
	list listen '127.0.0.1:8443@443'
	# A whitelist is required before enabling: set "white" to a file with
	# one host name per line, or set openproxy to '1' to forward any name.
	#option white '/etc/zroxy/whitelist.txt'
	#option openproxy '0'
	#option allowloopback '0'
	#option denyprivate '0'
	# Optional SOCKS5 upstream. Keep a password in a chmod 600 file:
	#option socks 'username@127.0.0.1:1080'
	#option socks_pass_file '/etc/zroxy/socks.pass'
	option snitimeout '30'
	#option sniidletimeout '300'
	option log '2'
	#option user 'zroxy'
	#option group 'zroxy'

# Optional local DNS service. Avoid port 53 (dnsmasq) and 5353 (mDNS).
config dns 'dns'
	option enabled '0'
	option listen '127.0.0.1:5354'
	#list acl '127.0.0.0/8'
	#option dsocks '127.0.0.1:1080'
	#option dsocks_pass_file '/etc/zroxy/dsocks.pass'
	#option timeout '5'
	#option cache '2048'
	#option ttl '300'
	#option rate '0'
	#option connections '8'
	#option snip '192.168.1.1'

# Upstream DNS routes, in order, up to 4 enabled. "via" is a SOCKS5 spec for
# this route only, or "direct" to skip the DNS SOCKS5 proxy:
#config route
#	option enabled '1'
#	option server '1.1.1.1:53'
#	option via '127.0.0.1:9050'

# Optional HTTP statistics monitor. Keep a token in a chmod 600 file.
config monitor 'monitor'
	option enabled '0'
	option listen '127.0.0.1:8123'
	#option token_file '/etc/zroxy/monitor.token'
	#option timeout '5'
